# ---------------------------------------------------------------------------
# globlejump backend — environment configuration
# Copy to `.env` and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# Runtime
ENVIRONMENT=local            # local | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false               # true => JSON logs (prod), false => console (dev)

# API
PROJECT_NAME="GlobleJump API"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Database (async, asyncpg). Either set DATABASE_URL directly...
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db
# ...or set the discrete parts below (used to build the DSN if DATABASE_URL is unset):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# Auth — tokens issued BY this service
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ISSUER=globlejump
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Auth — token lifetimes
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Auth — trust for tokens issued by the external identity-service.
# Provide a shared HS256 secret OR a JWKS URL (RS256). Leave blank to disable external trust.
IDENTITY_JWT_SECRET=
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=identity-service
IDENTITY_AUDIENCE=globlejump

# Auth — Google OAuth (authorization-code flow). Leave blank to disable.
# GOOGLE_REDIRECT_URI must match the value registered in the Google Cloud
# console byte-for-byte, including the /api/v1/auth prefix.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Zoom OAuth (Advisor account connect — leave blank to disable).
# ZOOM_REDIRECT_URI must match the Zoom Marketplace Redirect URL exactly,
# including /api/v1. Local make run uses port 8020.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://127.0.0.1:8020/api/v1/integrations/zoom/callback
ZOOM_FRONTEND_RETURN_PATH=/advisor/profile

# Email (transactional — leave blank to disable sending, tokens are logged instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@globlejump.io
EMAILS_FROM_NAME=GlobleJump
FRONTEND_URL=http://localhost:3000
# Absolute API origin for email images (logo / social icons). Leave blank to
# derive from GOOGLE_REDIRECT_URI, else http://localhost:8000.
PUBLIC_API_URL=

# File storage — S3 (leave blank to fall back to local disk storage under UPLOAD_DIR)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10
UPLOAD_ORPHAN_TTL_HOURS=24            # unused seeker_document uploads deleted after this
UPLOAD_ORPHAN_SWEEP_SECONDS=3600      # how often the orphan-upload sweep runs

# Push notifications — Firebase Cloud Messaging (leave FIREBASE_CREDENTIALS_FILE
# blank to disable push: the in-app notification feed still works and the outbox
# sweep marks pending rows `skipped`). Point it at a Firebase service-account JSON
# file (matched by *firebase-adminsdk*.json in .gitignore — never commit it).
FIREBASE_CREDENTIALS_FILE=
NOTIFICATION_PUSH_SWEEP_SECONDS=5          # outbox sweep interval
NOTIFICATION_PUSH_MAX_ATTEMPTS=5          # retries before a push is marked `failed`
NOTIFICATION_PUSH_STALE_HOURS=24          # pending rows older than this are skipped
NOTIFICATION_MAX_DEVICES_PER_USER=10      # oldest device tokens evicted beyond this

# OpenAI (AI assessment insights — leave key blank to disable; assessments still complete)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=20

# Observability (all optional — left blank => disabled)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=globlejump
